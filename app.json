{
  "expo": {
    "name": "Música",
    "slug": "oms-music",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "omsmusic",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "pt.omelhorsite.music",
      "buildNumber": "1",
      "supportsTablet": true,
      "associatedDomains": [
        "webcredentials:omelhorsite.pt",
        "applinks:omelhorsite.pt"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "pt.omelhorsite.music",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#660090",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "omelhorsite.pt",
              "pathPrefix": "/en/music"
            },
            {
              "scheme": "https",
              "host": "omelhorsite.pt",
              "pathPrefix": "/pt/music"
            },
            {
              "scheme": "https",
              "host": "omelhorsite.pt",
              "pathPrefix": "/lv/music"
            },
            {
              "scheme": "https",
              "host": "omelhorsite.pt",
              "pathPrefix": "/music"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withUISceneLifecycle",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#660090",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "./modules/oms-native/app.plugin.js",
      "expo-sqlite",
      "expo-secure-store",
      "expo-image",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
